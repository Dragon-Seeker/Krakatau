{
  "name": "krakatau-web",
  "version": "1.0.0-beta",
  "description": "Krakatau Java decompiler (modern-Java patched) running in a Web Worker via Pyodide",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "krak-client.mjs",
  "exports": {
    ".": {
      "types": "./krak-client.d.mts",
      "default": "./krak-client.mjs"
    },
    "./core": {
      "types": "./krak-core.d.mts",
      "default": "./krak-core.mjs"
    },
    "./worker": {
      "types": "./krak.worker.d.mts",
      "default": "./krak.worker.mjs"
    }
  },
  "files": [
    "krak-client.mjs",
    "krak-core.mjs",
    "krak.worker.mjs",
    "krak-client.d.mts",
    "krak-core.d.mts",
    "krak.worker.d.mts",
    "krakatau-cdn.d.ts",
    "krakatau-py.zip",
    "jdk-stubs.jar",
    "index.html",
    "LICENSE.TXT"
  ],
  "keywords": [
    "java",
    "decompiler",
    "krakatau",
    "pyodide",
    "webworker"
  ],
  "types": "./krak-client.d.mts"
}
